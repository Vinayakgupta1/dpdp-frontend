# Base URL of the DPDP Sentinel intake worker (see worker/ in this repo).
# Deploy the worker first, then copy this file to .env and set the real URL.
# Leave unset to keep the Landing form in a readable "not configured" state.
# Must end with /api/submissions (that is the only route the intake worker exposes).
REACT_APP_INTAKE_URL=https://dpdp-sentinel-intake.<ACCOUNT_ID>.workers.dev/api/submissions